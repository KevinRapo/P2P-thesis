<mxfile host="marlem-v1">
  <diagram name="The full cycle" id="full-cycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="train" value="TRAINING ITERATION, until the budget is spent&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;core/rl/train.py → RLlib algo.train()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;arcSize=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontStyle=1;fillColor=#faf7fc;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1520" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="collect" value="A · COLLECT: environment steps until the batch is full&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;RLlib env runners, with the current policy μ; nothing is learned&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;arcSize=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontStyle=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1120" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="A5 · ENVIRONMENT STEP&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;MarketEnv.step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;arcSize=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontStyle=1;fillColor=#f3f7fd;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="170" width="780" height="740" as="geometry"/>
        </mxCell>
        <mxCell id="market" value="MARKET STEP&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;LocalEnergyMarket.step: start_step, then advance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;arcSize=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;align=right;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="740" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="reset" value="&lt;b&gt;Episode start = one day&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;MarketEnv.reset → market phase 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;A1 observe&lt;/b&gt; o&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;16 numbers per agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;A2 actor forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;per agent (DTDE, CTDE) · joint (CTCE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;A3 sample&lt;/b&gt; u, log μ(u)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;Gaussian of the actor&#x27;s output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;A4 rescale&lt;/b&gt; u → a&lt;sub&gt;t&lt;/sub&gt; ∈ [−1, 1]²&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;quantity, price&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;E1 decode&lt;/b&gt; a&lt;sub&gt;t&lt;/sub&gt; → order intent (q from eq. 15a-b bound, p between p&lt;sub&gt;FiT&lt;/sub&gt; and p&lt;sub&gt;utility&lt;/sub&gt;)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;MarketEnv.decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
