# MARLEM settings. Copy this file to .env (git-ignored) and change what you need.
# Every value below is the default used when the variable is not set; a variable
# set in the terminal or a VS Code launch configuration overrides .env for that run.

# --- Studio (src_thesis/studio/app.py, state.py) ------------------------------
# Port of the Studio web server.
MARLEM_STUDIO_PORT=8080
# Open a browser tab on start: 1 = yes, 0 = no.
MARLEM_STUDIO_SHOW=1
# Restart the server when a .py file under src_thesis/ changes: 1 = yes, 0 = no.
MARLEM_STUDIO_RELOAD=1
# Signs the cookie that identifies a browser for app.storage.user. Any string;
# change it to forget all remembered drafts and dark-mode choices.
MARLEM_STUDIO_SECRET=marlem-studio-local
# Grid catalog: pandapower (real SimBench / pandapower networks) or demo.
MARLEM_STUDIO_GRID=pandapower
# Experiment files: files (real files in the workspace library) or demo.
MARLEM_STUDIO_CONFIG=files

# --- Workspace (src_thesis/application/workspace.py) --------------------------
# Folder with library/ (experiment files), store/ (runs) and exports/.
# Leave unset to use the folder chosen on the Studio's Settings page, or by
# default %LOCALAPPDATA%\MARLEM. When set, it overrides the Settings page.
# MARLEM_HOME=C:\Users\<you>\marlem-workspace

# --- NiceGUI ------------------------------------------------------------------
# Where NiceGUI keeps app.storage (per-browser state such as the open draft).
# Default: a .nicegui folder in the directory the Studio is started from.
# NICEGUI_STORAGE_PATH=C:\Users\<you>\AppData\Local\MARLEM\studio-state
