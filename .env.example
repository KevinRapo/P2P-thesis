# This machine's settings. Copy to .env (git-ignored) and fill in; an environment
# variable of the same name takes precedence. Read by core/settings.py and
# scripts/hpc.ps1. Commented keys show their default.

# The cluster (hpc/targets.toml, scripts/hpc.ps1). Needed on this PC and in the
# cluster's checkout (~/marlem-v2/.env) for SLURM submissions.
MARLEM_SLURM_ACCOUNT=
# MARLEM_SSH_HOST=taltech
# MARLEM_CLUSTER_REPO=~/marlem-v2
# MARLEM_CLUSTER_PYTHON=~/miniforge3/envs/marlem/bin/python

# Jupyter on the cluster (scripts/hpc.ps1, scripts/jupyter.slurm)
# MARLEM_JUPYTER_PORT=9437

# Folders (default: <repo>/runs; %LOCALAPPDATA%\MARLEM or ~/.local/share/marlem)
# MARLEM_RUNS=
# MARLEM_HOME=

# The Studio
# MARLEM_STUDIO_PORT=8090
# MARLEM_STUDIO_SHOW=1
