    "salazar_lr1e3": {
      "scenario": {
        "grid": {"generation_scale": 1.25}
      },
      "training": {
        "ppo": {"lr": 0.001}
      },
      "env_config": {"reward": "salazar", "observation": "paper"}
    }
  },
  "max_parallel": 5
