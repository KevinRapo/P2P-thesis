{
  "name": "thesis_e2",
  "description": "E2, the reconstructed Salazar reward: DTDE, PV x1.25, lr 1e-3, five seeds, pinned to green7 (green-ib), where five runs fit at once (RP-6d, amended); cut at Step 2's budget with analysis/heldout_at.py.",
  "scenario": "config/scenarios/thesis_rural1.json",
  "train_days": {"from": "2016-01-01", "to": "2016-12-30"},
  "validation_periods": {
    "winter": {"from": "2016-01-11", "to": "2016-01-17"},
