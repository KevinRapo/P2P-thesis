  "scenario": "config/scenarios/thesis_rural1.json",
  "train_days": {
    "from": "2016-01-01",
    "to": "2016-12-30"
  },
  "validation_periods": {
    "winter": {
      "from": "2016-01-11",
      "to": "2016-01-17"
    },
    "spring": {
      "from": "2016-04-11",
      "to": "2016-04-17"
    },
    "summer": {
      "from": "2016-07-11",
      "to": "2016-07-17"
    },
    "autumn": {
      "from": "2016-10-10",
      "to": "2016-10-16"
    }
  },
  "test_periods": {
    "winter": {
      "from": "2016-02-15",
      "to": "2016-02-21"
    },
    "spring": {
      "from": "2016-05-16",
      "to": "2016-05-22"
    },
    "summer": {
      "from": "2016-08-15",
      "to": "2016-08-21"
    },
    "autumn": {
      "from": "2016-11-14",
      "to": "2016-11-20"
