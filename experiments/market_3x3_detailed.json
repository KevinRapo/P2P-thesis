{
  "name": "market_3x3_detailed",
  "description": "All three algorithms x all three paradigms on the market, short budgets, held-out results step by step.",
  "env": "market",
  "scenario": "scenarios/validate_market.json",
  "train_days": {"from": "2016-06-01", "to": "2016-06-30"},
  "test_days": {"from": "2016-07-01", "to": "2016-07-14"},
  "env_config": {"energy_scale": null, "reward_scale": null},
  "algorithms": ["sac", "ppo", "appo"],
  "paradigms": ["ctce", "ctde", "dtde"],
  "seeds": [0],
  "variants": {},
  "budget": {"sac": 3000, "ppo": 8000, "appo": 8000},
  "eval_every": null,
  "eval_points": 10,
  "eval_episodes": 10,
  "results_detail": "detailed",
  "trace_days": 3,
  "training": {
    "sac": {
      "actor_lr": 0.0003,
      "critic_lr": 0.0003,
      "gamma": 0.99,
      "twin_q": true,
      "grad_clip": 0.5,
      "target_entropy": "auto",
      "replay_buffer_config": {"type": "MultiAgentEpisodeReplayBuffer", "capacity": 50000},
      "num_steps_sampled_before_learning_starts": 1000,
      "initial_alpha": 0.01
    },
    "ppo": {
      "lr": 0.0003,
      "gamma": 0.99,
      "lambda_": 0.95,
      "num_epochs": 10,
      "minibatch_size": 240,
      "entropy_coeff": 0.01,
      "clip_param": 0.2,
      "grad_clip": 0.5,
      "use_kl_loss": false,
      "vf_clip_param": 1000000.0,
      "train_batch_size_per_learner": 2000
    },
    "appo": {
      "lr": 0.0003,
      "gamma": 0.99,
      "entropy_coeff": 0.01,
      "grad_clip": 0.5,
      "use_kl_loss": false,
      "train_batch_size_per_learner": 2000
    }
  },
  "model": {
    "fcnet_hiddens": [256, 256],
    "fcnet_activation": "tanh",
    "head_fcnet_hiddens": [],
    "head_fcnet_activation": "relu",
    "free_log_std": false,
    "log_std_clip_param": 20.0,
    "vf_share_layers": false
  },
  "max_parallel": 9,
  "torch_threads": 1,
  "num_env_runners": 3,
  "ray_thread_caps": true,
  "resources": {"cpus": 4, "mem_gb": 4, "minutes": 30, "node": null},
  "test": {}
}
